<MudGrid>
    <MudItem sm="7">
        <MudCard>
            <MudCardContent>
                <MudSelect T="int" Label="Staff Member" @bind-Value="EmergencyContactDisplayModel.PersonId" Disabled="@DisablePeopleDropDownList">
                    @foreach (var person in People)
                    {
                        <MudSelectItem T="int" Value="@person.PersonId">
                            @person.FirstName @person.LastName
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudTextField Label="First Name" @bind-Value="EmergencyContactDisplayModel.FirstName" />
                <MudTextField Label="Last Name" @bind-Value="EmergencyContactDisplayModel.LastName" />
                <MudTextField Label="Phone Number" @bind-Value="EmergencyContactDisplayModel.PhoneNumber" />
                <MudSelect T="int" Label="Relationship" @bind-Value="EmergencyContactDisplayModel.RelationshipId">
                    @foreach (var relationship in Relationships)
                    {
                        <MudSelectItem T="int" Value="@relationship.RelationshipId">@relationship.RelationshipName</MudSelectItem>
                    }
                </MudSelect>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
