@inherits PersonBasePageClass

<MudTextField Label="First Name" @bind-Value="PersonDisplayModel.FirstName" AutoFocus OnlyValidateIfDirty="true" />
<MudTextField Label="Middle Names" @bind-Value="PersonDisplayModel.MiddleNames" />
<MudTextField Label="Last Name" @bind-Value="PersonDisplayModel.LastName" />
<MudTextField Label="Email Address" @bind-Value="PersonDisplayModel.EmailAddress" />
<MudTextField Label="Phone Number" @bind-Value="PersonDisplayModel.PhoneNumber" />
<MudSelect T="int?" Label="Personal Pronouns" @bind-Value="PersonDisplayModel.PersonalPronounsId">
    @foreach (var personalPronoun in PersonalPronouns)
    {
        <MudSelectItem T="int?" Value="@personalPronoun.PersonalPronounsId">@personalPronoun.PronounNames</MudSelectItem>
    }
</MudSelect>
<MudSelect T="int?" Label="Gender" @bind-Value="PersonDisplayModel.GenderId">
    @foreach (var gender in Genders)
    {
        <MudSelectItem T="int?" Value="@gender.GenderId">@gender.GenderName</MudSelectItem>
    }
</MudSelect>
<MudSelect T="int" Label="Employment Status" @bind-Value="PersonDisplayModel.EmploymentStatusId">
    @foreach (var employmentStatus in EmploymentStatuses)
    {
        <MudSelectItem T="int" Value="@employmentStatus.EmploymentStatusId">@employmentStatus.StatusName</MudSelectItem>
    }
</MudSelect>

<div class="my-4"></div>

<MudFileUpload T="IBrowserFile"
    FilesChanged="LocalUploadImage"
    Accept="image/*">
    <ActivatorContent>
        <MudButton HtmlTag="label"
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.FileUpload">
            Upload Image
        </MudButton>
    </ActivatorContent>
</MudFileUpload>

<br />
<br />

@if (PersonDisplayModel.Photo is not null)
{
    <p>@ImageName</p>

    <span>
        <MudButton Variant="Variant.Filled"
              Color="Color.Error"
              OnClick="LocalRemoveImage">
            Remove Image
        </MudButton>
    </span>

    <br />
    <br />
}

<ViewImageComponent ImageData="PersonDisplayModel.Photo"
                    ImageTitle="@($"{PersonDisplayModel.FirstName} {PersonDisplayModel.LastName}")"
                    ImageMimeType="@PersonDisplayModel.PhotoMimeType"/>

<br />
<br />

<div class="my-4"></div>

<MudFileUpload T="IBrowserFile"
    FilesChanged="LocalUploadPronunciation"
    Accept="audio/*">
    <ActivatorContent>
        <MudButton HtmlTag="label"
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.FileUpload">
            Upload Pronunciation
        </MudButton>
    </ActivatorContent>
</MudFileUpload>

<br />
<br />

@if (PersonDisplayModel.Pronunciation is not null)
{
    <p>@PronunciationName</p>

    <span>
        <MudButton Variant="Variant.Filled"
              Color="Color.Error"
              OnClick="LocalRemovePronunciation">
            Remove Pronunciation
        </MudButton>
    </span>

    <br />
    <br />
}

<HearPronunciationComponent PronunciationData="PersonDisplayModel.Pronunciation"
                    PronunciationTitle="@($"{PersonDisplayModel.FirstName} {PersonDisplayModel.LastName}")" />
