<MudTable Items="Colours"
          Hover
          FixedHeader="true">
    <HeaderContent>
        <MudTh title="Sort by Colour Name">
            <MudTableSortLabel SortBy="new Func<ColourModel, object>(x => x.ColourName)">
                Colour Name
            </MudTableSortLabel>
        </MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.ColourName</MudTd>
        <MudTd>
            <a href="/vehiclemanager/colour/view/@context.ColourId" class="btn btn-primary">View</a>
            &nbsp;
            <a href="/vehiclemanager/colour/edit/@context.ColourId" class="btn btn-primary">Edit</a>
            @if (!context.Vehicles.Any())
            {
                @:&nbsp;
                <a href="/vehiclemanager/colour/delete/@context.ColourId" class="btn btn-danger">Delete</a>
            }
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 5, 10, 15, int.MaxValue }" />
    </PagerContent>
</MudTable>