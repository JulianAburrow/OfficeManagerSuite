@page "/personmanager/gender/delete/{GenderId:int}"
@inherits GenderBasePageClass

<PageTitle>Delete Gender</PageTitle>

@if (GenderModel is null)
{
    <LoadingOrNotFoundComponent ValueToShow="@GenderSingular" />
    return;
}

@if (!OkToEditOrDelete)
{
    <CannotEditOrDeleteComponent
        WhichManager="@ManagerEnum.person.ToString()"
        ObjectType="@GenderPlural"
        ObjectName="@GenderModel.GenderName"
        ObjectCount="@GenderModel.Persons.Count" />
    return;
}

<ConfirmDeleteComponent ObjectType="@GenderSingular" ObjectName="@GenderModel.GenderName" />

<br />
<br />

<GenderViewDeleteComponent GenderName="@GenderModel.GenderName" />

<br />
<br />

@if (OkToEditOrDelete)
{
    <button class="btn btn-danger" @onclick="DeleteGender">Delete</button>
    @:&nbsp;
}

<a class="btn btn-primary" href="/personmanager/genders/index">Cancel</a>