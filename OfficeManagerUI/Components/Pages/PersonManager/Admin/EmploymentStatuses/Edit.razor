@page "/personmanager/employmentstatus/edit/{EmploymentStatusId:int}"
@inherits EmploymentStatusBasePageClass

<PageTitle>Edit Address Type</PageTitle>

@if (EmploymentStatusDisplayModel == null)
{
    <LoadingOrNotFoundComponent ValueToShow="@EmploymentStatusSingular" />
    return;
}

@if (!OkToEditOrDelete)
{
    <CannotEditOrDeleteComponent
        WhichManager="@ManagerEnum.person.ToString()"
        ObjectType="@EmploymentStatusPlural"
        ObjectCount="EmploymentStatusDisplayModel.PersonCount"
        ObjectName="@EmploymentStatusDisplayModel.StatusName" />
    <br />
    <a class="btn btn-primary" href="/personmanager/employmentstatuses/index">Cancel</a>
    return;

}

<EditForm Model="@EmploymentStatusDisplayModel" OnValidSubmit="UpdateEmploymentStatus">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem sm="7">
            <MudCard>
                <EmploymentStatusCreateUpdateComponent EmploymentStatusDisplayModel="@EmploymentStatusDisplayModel" />
                <MudCardActions>
                    <button type="submit" class="btn btn-primary">Update</button>
                    &nbsp;
                    <a class="btn btn-primary" href="/personmanager/employmentstatuses/index">Cancel</a>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>

