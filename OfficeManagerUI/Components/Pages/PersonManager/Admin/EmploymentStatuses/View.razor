@page "/personmanager/employmentstatus/view/{EmploymentStatusId:int}"
@inherits EmploymentStatusBasePageClass

<PageTitle>View Address Type</PageTitle>

@if (EmploymentStatusModel is null)
{
    <LoadingOrNotFoundComponent ValueToShow="@EmploymentStatusSingular" />
    return;
}

<MudGrid>
    <MudItem sm="7">
        <MudCard>
            <MudCardContent>
                <AddressTypeViewDeleteComponent TypeName="@EmploymentStatusModel.StatusName" />
            </MudCardContent>
            <MudCardActions>
                @if (OkToEditOrDelete)
                {
                    <a class="btn btn-primary" href="/personmanager/employmentstatus/edit/@EmploymentStatusModel.EmploymentStatusId">Edit</a>
                    @:&nbsp;
                    <a class="btn btn-danger" href="/personmanager/employmentstatus/delete/@EmploymentStatusModel.EmploymentStatusId">Delete</a>
                }
                &nbsp;
                <a class="btn btn-primary" href="/personmanager/employmentstatuses/index">Cancel</a>"
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>