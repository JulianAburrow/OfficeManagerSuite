@page "/personmanager/emergencycontacts/index/{PersonId:int}"
@inherits EmergencyContactBasePageClass

<PageTitle>Emergency Contacts</PageTitle>

<a href="/personmanager/emergencycontact/create/@PersonId" class="btn btn-primary">Create Emergency Contact</a>
@if (PersonId > 0)
{
    @:&nbsp;
    <a href="/personmanager/person/view/@PersonId" class="btn btn-primary">View Person</a>
}

<br />
<br />

@if (EmergencyContacts is null || !EmergencyContacts.Any())
{
    <LoadingOrNotFoundComponent ValueToShow="@EmergencyContactPlural" />
    return;
}

<EmergencyContactGridviewComponent EmergencyContacts="@EmergencyContacts" ShowStaffMember="@(PersonId == 0)" />