@page "/personmanager/personalpronouns/delete/{PersonalPronounsId:int}"
@inherits PersonalPronounsBasePageClass

<PageTitle>Delete Personal Pronouns</PageTitle>

@if (PersonalPronounsModel is null)
{
    <LoadingOrNotFoundComponent ValueToShow="@PersonalPronounsSingular" />
    return;
}

@if (!OkToEditOrDelete)
{
    <CannotEditOrDeleteComponent
        WhichManager="@ManagerEnum.person.ToString()"
        ObjectType="@PersonalPronounsPlural"
        ObjectName="@PersonalPronounsModel.PronounNames"
        ObjectCount="@PersonalPronounsModel.Persons.Count" />
    return;
}

<ConfirmDeleteComponent ObjectType="@PersonalPronounsSingular" ObjectName="@PersonalPronounsModel.PronounNames" />

<br />
<br />

<PersonalPronounsViewDeleteComponent PersonalPronouns="@PersonalPronounsModel.PronounNames" />

<br />
<br />

@if (OkToEditOrDelete)
{
    <button class="btn btn-danger" @onclick="DeletePersonalPronouns">Delete</button>
    @:&nbsp;
}

<a class="btn btn-primary" href="/personmanager/personalpronouns/index">Cancel</a>

