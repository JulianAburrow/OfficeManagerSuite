@page "/personmanager/address/view/{AddressId:int}"
@inherits AddressBasePageClass

<PageTitle>View Address</PageTitle>

@if (AddressModel is null || AddressModel.AddressType is null)
{
    <LoadingOrNotFoundComponent ValueToShow="@AddressSingular" />
    return;
}

<MudGrid>
    <MudItem sm="7">
        <MudCard>
            <MudCardContent>
                <AddressViewDeleteComponent AddressModel="@AddressModel" />
            </MudCardContent>
            <MudCardActions>
                <a class="btn btn-primary" href="/personmanager/address/edit/@AddressModel.AddressId">Edit</a>
                &nbsp;
                <a class="btn btn-danger" href="/personmanager/address/delete/@AddressModel.AddressId">Delete</a>
                &nbsp;
                <a class="btn btn-primary" href="/personmanager/addresses/index/@AddressModel.PersonId">Cancel</a>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@if (!ShowMap)
{
    return;
}

<br />

<div id="map" style="width: 100%;height:400px;"></div>