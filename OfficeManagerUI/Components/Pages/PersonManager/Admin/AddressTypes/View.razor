@page "/personmanager/addresstype/view/{AddressTypeId:int}"
@inherits AddressTypeBasePageClass

<PageTitle>View Address Type</PageTitle>

@if (AddressTypeModel is null)
{
    <LoadingOrNotFoundComponent ValueToShow="@AddressTypeSingular" />
    return;
}

<MudGrid>
    <MudItem sm="7">
        <MudCard>
            <MudCardContent>
                <AddressTypeViewDeleteComponent TypeName="@AddressTypeModel.TypeName" />
            </MudCardContent>
            <MudCardActions>
                @if (OkToEditOrDelete)
                {
                    <a class="btn btn-primary" href="/personmanager/addresstype/edit/@AddressTypeModel.AddressTypeId">Edit</a>
                    @:&nbsp;
                    <a class="btn btn-danger" href="/personmanager/addresstype/delete/@AddressTypeModel.AddressTypeId">Delete</a>
                    @:&nbsp;
                }
                <a class="btn btn-primary" href="/personmanager/addresstypes/index">Cancel</a>"
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>