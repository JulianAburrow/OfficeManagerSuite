@page "/personmanager/addresstype/delete/{AddressTypeId:int}"
@inherits AddressTypeBasePageClass

<PageTitle>Delete Address Type</PageTitle>

@if (AddressTypeModel is null)
{
    <LoadingOrNotFoundComponent ValueToShow="@AddressTypeSingular" />
    return;
}

@if (!OkToEditOrDelete)
{
    <CannotEditOrDeleteComponent
        WhichManager="@ManagerEnum.person.ToString()"
        ObjectType="@AddressTypePlural"
        ObjectName="@AddressTypeModel.TypeName"
        ObjectCount="@AddressTypeModel.Addresses.Count" />
    return;
}

<ConfirmDeleteComponent ObjectType="@AddressTypeSingular" ObjectName="@AddressTypeModel.TypeName" />

<br />
<br />

<AddressTypeViewDeleteComponent TypeName="@AddressTypeModel.TypeName" />

<br />
<br />

<button class="btn btn-danger" @onclick="DeleteAddressType">Delete</button>
&nbsp;
<a class="btn btn-primary" href="/personmanager/addresstypes/index">Cancel</a>