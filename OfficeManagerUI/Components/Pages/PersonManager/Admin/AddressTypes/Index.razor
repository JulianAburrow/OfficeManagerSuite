@page "/personmanager/addresstypes/index"
@inherits AddressTypeBasePageClass

@using OfficeManagerUI.Components.Shared.Components.People

<PageTitle>Address Types</PageTitle>

<a href="/personmanager/addresstype/create" class="btn btn-primary">Create Address Type</a>

<br />
<br />

@if (AddressTypes is null || !AddressTypes.Any())
{
    <LoadingOrNotFoundComponent ValueToShow="@AddressTypePlural" />
    return;
}

<AddressTypeGridviewComponent AddressTypes="@AddressTypes" />